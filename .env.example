APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# "daily" rotates and prunes old files automatically (LOG_DAILY_DAYS, default 14) —
# "single" writes to one ever-growing file, don't use it in production.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# debug is fine locally; use "error" (or at least "warning") in production to avoid
# drowning the log in noise.
LOG_LEVEL=debug

# Rendu côté serveur (SSR) — sans lui, les crawlers et les robots Open Graph ne reçoivent
# qu'une page vide : aucune balise SEO n'existe côté client. Voir docs/SSR_DEPLOYMENT.md.
# En prod (Docker), ces deux valeurs sont passées au conteneur `app` via compose et
# pointent le service ssr — le défaut 127.0.0.1 désignerait le conteneur app lui-même.
# En local, laisser 127.0.0.1 et lancer `php artisan inertia:start-ssr` après `npm run build`.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# Error tracking (https://sentry.io) — leave empty to disable, no code change needed.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# Laisser SENTRY_SEND_DEFAULT_PII à false : notre page "Sous-traitants" déclare
# publiquement que Sentry ne reçoit ni nom ni email (seulement un identifiant de
# compte). L'activer enverrait ces données et rendrait cette déclaration fausse —
# il faudrait alors mettre à jour i18n/subprocessors.ts.
SENTRY_SEND_DEFAULT_PII=false

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=batix_saas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Copie hors-site des sauvegardes de base (db:backup, tous les jours à 3h).
# Tant que BACKUP_S3_BUCKET est vide, les dumps restent sur le disque du serveur :
# ils couvrent une migration ratée, pas la perte de la machine. La commande le
# signale à chaque exécution plutôt que de laisser croire à une copie distante.
# Compatible S3 : Backblaze B2, Cloudflare R2, Scaleway, OVH... Laisser
# BACKUP_S3_ENDPOINT vide pour AWS S3 lui-même.
# Exemple B2  : https://s3.eu-central-003.backblazeb2.com  (region eu-central-003)
# Exemple R2  : https://<account_id>.r2.cloudflarestorage.com  (region auto)
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=prod
BACKUP_S3_PATH_STYLE=false

VITE_APP_NAME="${APP_NAME}"

# Google Analytics 4 — public marketing site only (Home, Blog, Fonctionnalités,
# Tarifs, Clients, Ressources, À propos, Contact). Leave empty to disable.
VITE_GA4_MEASUREMENT_ID=

# PawaPay Mobile Money Hub
PAWAPAY_API_TOKEN=
PAWAPAY_SANDBOX=true

JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=

# Moneroo — orchestration mobile money (Wave, Orange, MTN, Moov) + carte
# Le secret webhook est distinct de la clé API et se configure dans le tableau de bord.
MONEROO_ENABLED=false
MONEROO_API_KEY=
MONEROO_WEBHOOK_SECRET=
# Optionnel, utile uniquement pour pointer vers un environnement de développement.
# MONEROO_BASE_URL=https://api.moneroo.io

# LemonSqueezy Payment Platform
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Anthropic AI Agent (assistant IA interne)
ANTHROPIC_API_KEY=

# Passerelle MCP BATIXPRO — endpoint par lequel l'assistant IA exécute ses tools.
# Local : http://localhost:3111/mcp   |   Prod (Docker) : http://batixpro-mcp:3000/mcp
BATIXPRO_MCP_URL=http://localhost:3111/mcp
